# Ametrine 后端配置模板
#
#   cp apps/backend/.env.example apps/backend/.env
#
# .env 不进版本库（见仓库根 .gitignore）。
# 下列键在 src/config.py 里没有默认值，缺任何一个应用都起不来：
#   ALGORITHM、SECRET_KEY、ACCESS_TOKEN_EXPIRE_MINUTES、XINFERENCE_MAIN_ADDR、
#   XINFERENCE_{LLM,EMBEDDING,RERANK}_MODEL_ID、TOKENIZER_ADDR、DB_ADDR、DOC_ADDR、
#   K、P、MIN_RELEVANCE_SCORE、CHUNK_SIZE、CHUNK_OVERLAP、MAX_MODEL_LEN、
#   POSTGRE_ADDR、POSTGRE_LOG、SEMANTIC_SPLITTER、OCR_AGENT、SEMAPHORE
# 其余留空即用默认值。
# 另外 Settings 是 extra="ignore"：写了没人读的键不会报错，只会静悄悄无效 ——
# 例如 XINFERENCE_STT_MODEL_ID，自建 ASR 移除后已无人读取。

# ── 鉴权 ──────────────────────────────────────────────────────────
ALGORITHM="HS256"
# 每个部署新生成一个，绝不复用、绝不提交：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-me-with-a-fresh-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── 推理服务（Xinference）─────────────────────────────────────────
# 模型按 **uid** 引用，不是 model_name；两者可以不同，填错会得到「Model not found」
XINFERENCE_MAIN_ADDR="http://127.0.0.1:9997"
# 服务端未开鉴权就留空
XINFERENCE_API_KEY=""
XINFERENCE_LLM_MODEL_ID="qwen3-4b"
# 下面两个只被 scripts/load_models.sh 读取，应用本身不用
XINFERENCE_LLM_SIZE="4"
XINFERENCE_LLM_ENGINE="Transformers"
XINFERENCE_EMBEDDING_MODEL_ID="bge-m3"
# 必须与 embedding 模型的实际输出维度一致；改它等于全量重建索引
EMBEDDING_DIMENSION=1024
XINFERENCE_RERANK_MODEL_ID="bge-reranker-base"
# OCR 模型 id 同样只给加载脚本用
XINFERENCE_OCR_MODEL_ID="GOT-OCR2_0"
# 分词器：可以是 hub id（首次会联网下载一次），也可以是本地绝对路径。
# 网络不通时配合 HF_ENDPOINT 镜像；填了绝对路径但目录不存在会得到一条
# 完全不提 TOKENIZER_ADDR 的 HFValidationError。
TOKENIZER_ADDR="Qwen/Qwen2.5-0.5B-Instruct"

# ── 向量库（Milvus）───────────────────────────────────────────────
MILVUS_HOST="127.0.0.1"
MILVUS_PORT="19530"
# L2 是「距离越小越相似」；MIN_RELEVANCE_SCORE 那种 0..1 阈值只适用于重排相关性分，
# 两套分数不要混用同一个阈值。
MILVUS_METRIC_TYPE="L2"
MILVUS_INDEX_TYPE="IVF_FLAT"
MILVUS_INDEX_NLIST=256
# 向量落盘目录（standalone Milvus 的数据目录）
DB_ADDR="apps/database/db_vector"
# 上传文档的落盘目录
DOC_ADDR="apps/database/docs"

# ── 检索与切分 ────────────────────────────────────────────────────
# 向量召回候选数
K=5
# 最终进入上下文条数
P=3
# 重排相关性下限（0..1）
MIN_RELEVANCE_SCORE=0.3
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# 提示词截断上限（token）。受模型上下文限制约束，别大于显存能支撑的窗口
MAX_MODEL_LEN=4096
# 语义切分（按句义断开，对中文文档几乎是必需的）
SEMANTIC_SPLITTER=true

# ── 关系库（PostgreSQL）───────────────────────────────────────────
# 异步 DSN。口令请改成你自己创建的那个，并把 .env 保持在版本库之外
POSTGRE_ADDR="postgresql+asyncpg://postgres:replace-me@localhost:5432/ametrine"
POSTGRE_LOG=false

# ── 其它 ──────────────────────────────────────────────────────────
# 解析器实现（OCR 走 tesseract；未装 OCR 模型时该路径不会被触发）
OCR_AGENT="unstructured.partition.utils.ocr_models.tesseract_ocr.TesseractOCRAgent"
# 并发推理闸门（注意：当前只约束「开流」这一步，不是整段生成）
SEMAPHORE=32

# Redis 目前没有配置项：连接写在 src/client.py（127.0.0.1:6379, db 0）。

# ── 代理（可选）───────────────────────────────────────────────────
# 本机有出网代理时才填；NO_PROXY 一定要包含 127.0.0.1/localhost，
# 否则连本地 Xinference、Postgres 的请求也会被代理接管而变成 403/502。
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="localhost,127.0.0.1,.local"
