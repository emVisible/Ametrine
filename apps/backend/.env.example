# Ametrine 后端配置模板
#
#   cp apps/backend/.env.example apps/backend/.env
#
# .env 不进版本库（见仓库根 .gitignore）。
# 下列键在 src/config.py 里没有默认值，缺任何一个应用都起不来：
#   ALGORITHM、SECRET_KEY、ACCESS_TOKEN_EXPIRE_MINUTES、XINFERENCE_MAIN_ADDR、
#   XINFERENCE_{LLM,EMBEDDING,RERANK}_MODEL_ID、TOKENIZER_ADDR、DOC_ADDR、
#   K、P、MIN_RELEVANCE_SCORE、CHUNK_SIZE、CHUNK_OVERLAP、MAX_MODEL_LEN、
#   POSTGRE_ADDR、POSTGRE_LOG、SEMANTIC_SPLITTER、OCR_AGENT、SEMAPHORE
# 其余留空即用默认值。
# 另外 Settings 是 extra="ignore"：写了没人读的键不会报错，只会静悄悄无效 ——
# 例如 XINFERENCE_STT_MODEL_ID（自建 ASR 移除后已无人读取），以及 DB_ADDR
# （它是以前 standalone Milvus 的落盘目录；应用从不读它，现在已从必需键里删掉，
# 老 .env 里留着也不会再有任何作用 —— Milvus 的数据位置由它的容器/配置决定）。

# ── 鉴权 ──────────────────────────────────────────────────────────
ALGORITHM="HS256"
# 每个部署新生成一个，绝不复用、绝不提交：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 启动时会校验这个值：少于 32 字符、仍是占位前缀、或只用了 ≤8 种字符，
# 应用**直接拒绝启动**并给出上面这条命令。HS256 的强度全押在密钥熵上，
# 一个 8 字符的密钥是可以离线爆破的，而它签发的是「管理员」身份。
# 换密钥会让所有已签发的 token 失效，所有人都要重新登录一次。
SECRET_KEY="replace-me-with-a-fresh-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── 浏览器来源（CORS）─────────────────────────────────────────────
# 逗号分隔的**精确来源列表**，不要写 "*"：allow_credentials=True 与通配来源并存，
# 等于允许任何网页拿着用户浏览器里已有的 token 打这台机器。
# 默认值是 vite 开发服务器的地址；换了端口或从别的机器打开前端，就把它加进来。
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"

# ── 推理服务（Xinference）─────────────────────────────────────────
# 模型按 **uid** 引用，不是 model_name；两者可以不同，填错会得到「Model not found」
XINFERENCE_MAIN_ADDR="http://127.0.0.1:9997"
# xinference 3.x **默认就开鉴权**（`XINFERENCE_AUTH_ADVANCED` 控制；实测 3.5.0 起来就是
# GET /v1/models → 401），所以「不配凭据也能跑」这条路在 3.x 上不存在。
# 现在应用用的是**下面那对管理员口令换来的用户级 JWT**（src/inference/auth.py 现签，
# 401 自动重签一次），推理与管理共用它。这把 API key 因此不再是必需项：
# 它的 scope 只有 models:read / models:list，**连 launch 都做不了**（实测 403），
# 而应用要做的事（推理 + 管理台加载）JWT 都覆盖，key 反而只多一个会过期的凭据。
# 留着这个键是为了兼容你自己拿它去接别的东西；填了就一起带上，没填就用 JWT。
XINFERENCE_API_KEY=""
# 这两个键**应用本身也会读**（不只是脚本用）：后端拿它们 POST /token 换 JWT，
# 管理台「重连凭据」按钮就是重新走一遍这条路。改完口令不必重启后端。
# 已有账号可以查：sqlite3 ~/.xinference/auth/auth.db 'select username from users'
XINFERENCE_ADMIN_USER=""
XINFERENCE_ADMIN_PASSWORD=""
# ⚠ 下面三个 model id 已经**降级为第一次的种子**（deprecated，仍可用一个版本）：
# 「跑哪个模型」现在存在数据库的 inference_role_binding 表里，在管理台
# 「模型推理」页改，改完立即生效、不用重启、也不用再动 .env。
# 它们剩下的作用只有一个：表还是空的（第一次，或者你从没在界面里配过）时，
# 后端用这三个值把表播种一遍，于是老部署不改任何东西也照样起得来。
# 播种过一次之后这三个值就不再被读到 —— 想换模型请在界面里换，别在这儿改。
XINFERENCE_LLM_MODEL_ID="qwen3-4b"
# 这两个只被 scripts/load_models.sh（首次 bootstrap）读取，应用本身不用
XINFERENCE_LLM_SIZE="4"
XINFERENCE_LLM_ENGINE="Transformers"
XINFERENCE_EMBEDDING_MODEL_ID="bge-m3"
# 必须与 embedding 模型的实际输出维度一致；改它等于全量重建索引
EMBEDDING_DIMENSION=1024
XINFERENCE_RERANK_MODEL_ID="bge-reranker-base"
# OCR 模型 id 同样只给加载脚本用
XINFERENCE_OCR_MODEL_ID="GOT-OCR2_0"
# 分词器：可以是 hub id（首次会联网下载一次），也可以是本地绝对路径。
# 网络不通时配合 HF_ENDPOINT 镜像；填了绝对路径但目录不存在会得到一条
# 完全不提 TOKENIZER_ADDR 的 HFValidationError。
TOKENIZER_ADDR="Qwen/Qwen2.5-0.5B-Instruct"

# ── 向量库（Milvus）───────────────────────────────────────────────
MILVUS_HOST="127.0.0.1"
MILVUS_PORT="19530"
# L2 是「距离越小越相似」；MIN_RELEVANCE_SCORE 那种 0..1 阈值只适用于重排相关性分，
# 两套分数不要混用同一个阈值。
MILVUS_METRIC_TYPE="L2"
MILVUS_INDEX_TYPE="IVF_FLAT"
MILVUS_INDEX_NLIST=256
# 上传文档的落盘目录。**写绝对路径**最省心；写相对路径时它按**仓库根**解析
# （不是按当前工作目录 —— uvicorn 的 cwd 是 apps/backend，照旧写法会落到
# apps/backend/apps/database/docs 那种没人期望的地方）。
# 启动时就会创建并检查可写：建不出来或不可写，应用直接拒绝启动并点名这个键。
DOC_ADDR="apps/database/docs"
# 单个文件上限（字节），默认 15 MiB。超限的文件在读流过程中就被掐掉并删除半截文件，
# 而不是先整份进内存再判断。类型另有白名单，取自解析器实际认识的扩展名。
MAX_UPLOAD_BYTES=15728640

# ── 入侧预算（请求体上限）────────────────────────────────────────
# 出侧有 K / P / MIN_RELEVANCE_SCORE，入侧原来什么都没有：
# top_k 想给多大给多大、prompt 想多长按历史算不算，都是共享算力的放大面。
# 越界一律 422 明说原因，不静默夹小（静默改参数是另一种不诚实）。
MAX_TOP_K=20
MAX_PROMPT_CHARS=8000
MAX_HISTORY_MESSAGES=50

# ── 检索与切分 ────────────────────────────────────────────────────
# 向量召回候选数
K=5
# 最终进入上下文条数
P=3
# 重排相关性下限（0..1）。**不要凭感觉填**：这是整条 RAG 路上唯一能把
# 「有依据的回答」变成「我没有参考信息」的开关，而 bge-reranker 在这类语料上的
# 分数分布和大多数人预期的不一样。
#
# 实测值（rag-bench/calibrate_threshold.py，105 篇真实文档 / 120 条金标查询 /
# 255 个金标块 vs 945 个非金标块，2026-10-01 跑的 --live 阈值扫描）：
#   阈值     金标保留   噪声通过   结果是「一条引用都没有」的查询比例
#   0.001     0.796      0.221     0.20
#   0.003     0.702      0.108     0.30
#   0.005     0.675      0.089     0.317
#   0.01      0.620      0.068     0.358
#   0.05      0.467      0.022     0.467
#   0.30      0.286      0.005     0.650   ← 以前这里的默认值
#   金标分数的中位数是 0.0397 —— 也就是说 0.3 比一半的真答案还高出近 8 倍。
# 关键是这个开关只会**单向**起作用：进上下文的条数由 P 封顶，阈值往下砍不会让回答更稳，
# 只会把已经排好序的依据砍成零。所以 0.3 的实际效果是「65% 的问题拒答」，
# 而重排本身的排序是**优于**纯向量的（同一批候选，不看阈值：hit@1 0.533 vs 0.467、MRR 0.564 vs 0.515）。
# 0.005 是这条曲线的拐点：再往上一档丢 5.5 个百分点的金标只换来少 2 个百分点的噪声，
# 而往 0.3 方向走每一档都在成批地把可用依据砍没。
MIN_RELEVANCE_SCORE=0.005
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# 提示词截断上限（token）。受模型上下文限制约束，别大于显存能支撑的窗口
MAX_MODEL_LEN=4096
# 语义切分（按句义断开，对中文文档几乎是必需的）
SEMANTIC_SPLITTER=true

# ── 关系库（PostgreSQL）───────────────────────────────────────────
# 异步 DSN。口令请改成你自己创建的那个，并把 .env 保持在版本库之外。
# 这一条同时是**迁移的 DSN**：alembic/env.py 现在读它，不再读 alembic.ini 里那条写死的
# `sqlalchemy.url`（那条已清空）。所以「应用连的库」和「upgrade head 打的库」不可能再分叉。
POSTGRE_ADDR="postgresql+asyncpg://postgres:replace-me@localhost:5432/ametrine"
POSTGRE_LOG=false

# ── 其它 ──────────────────────────────────────────────────────────
# 解析器实现（OCR 走 tesseract；未装 OCR 模型时该路径不会被触发）
OCR_AGENT="unstructured.partition.utils.ocr_models.tesseract_ocr.TesseractOCRAgent"
# 并发推理闸门（注意：当前只约束「开流」这一步，不是整段生成）
SEMAPHORE=32
# 单个账号同时在生成的回答路数；超出直接 429，避免一个人开一堆标签页占满整机。
# <=0 表示不限制。
MAX_CONCURRENT_STREAMS_PER_USER=2
# 两块输出之间的最大间隔（秒），不是回答总时长 —— 长答案是合法需求，卡住的上游才是故障。
STREAM_IDLE_TIMEOUT_SECONDS=120

# ── Redis（会话内引用、并发闸门、登录失败计数）──────────────────────
# 这四个键以前不存在：连接参数写死在 src/client.py 的 `Redis(host="127.0.0.1", port=6379, db=0)`，
# 于是「Redis 换端口 / 加密码 / 放到另一台机器」都得改代码。现在走配置，默认值就是原来那组，
# 老部署什么都不填也照旧。
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
# 留空 = 不带 AUTH。apps/database/docker-compose.yml 起的 Redis 是**无密码且监听 0.0.0.0** 的，
# 内网之外可达的机器必须给它加 requirepass，然后在这里填上；
# 同一个 Redis 实例被多个部署共用时，靠 REDIS_DB 隔开命名空间。
REDIS_PASSWORD=""

# ── 代理（可选）───────────────────────────────────────────────────
# 本机有出网代理时才填；NO_PROXY 一定要包含 127.0.0.1/localhost，
# 否则连本地 Xinference、Postgres 的请求也会被代理接管而变成 403/502。
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="localhost,127.0.0.1,.local"
