code_collection.txt

# 本地配置：SECRET_KEY、数据库口令、模型 id 都在这里面，绝不进版本库。
# 模板是 .env.example（要跟踪），所以这里只挡精确文件名。
.env
.env.*
!.env.example

# frontend
node_modules
dist
dist-ssr
stats.html
*.local
sample.mp3
*.ttf

# backend
__pycache__
.venv/
venv/
docs/*
!docs/refactor/
!docs/refactor/**
*.bin
*.log
env_rag

# RAG 基准：抓下来的语料与运行产物都是数据，不是代码（脚本本身要跟踪）
rag-bench/corpus/
rag-bench/corpus-original/
rag-bench/formats/
rag-bench/formats-candidates.json
rag-bench/*.out
rag-bench/__pycache__/
rag-bench/ACCOUNT
rag-bench/.tmp-*


# database
apps/database/volumes/*
apps/database/docs/*
apps/backend/storage/*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

